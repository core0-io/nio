{
  "$ref": "#/definitions/ContentRecord",
  "definitions": {
    "ContentRecord": {
      "type": "object",
      "properties": {
        "traceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "spanId": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "attributes": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "nio.content.truncated": {
                  "type": "boolean"
                },
                "nio.content.original_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "nio.content.redactions": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "nio.trace_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "nio.span_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "gen_ai.input.messages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "const": "user"
                      },
                      "parts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "text",
                                "reasoning"
                              ]
                            },
                            "content": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type",
                            "content"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "role",
                      "parts"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 1
                },
                "gen_ai.output.messages": {
                  "not": {}
                }
              },
              "required": [
                "gen_ai.input.messages"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "nio.content.truncated": {
                  "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/nio.content.truncated"
                },
                "nio.content.original_bytes": {
                  "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/nio.content.original_bytes"
                },
                "nio.content.redactions": {
                  "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/nio.content.redactions"
                },
                "nio.trace_id": {
                  "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/nio.trace_id"
                },
                "nio.span_id": {
                  "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/nio.span_id"
                },
                "gen_ai.output.messages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "const": "assistant"
                      },
                      "finish_reason": {
                        "type": "string"
                      },
                      "parts": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/ContentRecord/properties/attributes/anyOf/0/properties/gen_ai.input.messages/items/properties/parts/items"
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "role",
                      "finish_reason",
                      "parts"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 1
                },
                "gen_ai.input.messages": {
                  "not": {}
                }
              },
              "required": [
                "gen_ai.output.messages"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "traceId",
        "spanId",
        "attributes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
